# Node B - second independent BNKR node (VPS or Render).
# Copy to .env and fill in your own hostnames. Never commit the filled-in file.

# HTTP listener. Render injects PORT automatically; set it here only for VPS.
HOST=0.0.0.0
PORT=4174

# Persistent storage. Use a mounted disk path, never a repo .db file.
DB_PATH=/var/lib/bnkr/node-b.db

# The URL peers must use to reach THIS node. No trailing slash.
# Public HTTPS is required for reverse registration; SSRF screening rejects private IPs.
PUBLIC_URL=https://banneker-coin-node-b.onrender.com

# Comma-separated live BNKR seeds, excluding this node. Each seed registers
# back via POST /api/peers and transitive discovery closes the full mesh.
SEED_PEERS=https://banneker-coin.onrender.com,https://the-black-coin.onrender.com

# Keep false in production. Set ALLOW_LOCAL_PEERS=true ONLY for localhost tests.
ALLOW_LOCAL_PEERS=false
NODE_ENV=production
